# Portable wifit3 driver and integrated 802.1X/EAP server.
# Deliberately excludes nl80211/libnl and Linux-specific AP interfaces.
CONFIG_DRIVER_WIFIT3=y
CONFIG_DRIVER_NONE=y
CONFIG_NATIVE_WINDOWS=y
# OpenSSL 3 uses opaque RSA types; use PEM keys instead of the legacy
# Windows CryptoAPI RSA_METHOD shim in this native build.
CONFIG_NO_WINDOWS_CRYPTOAPI=y
CONFIG_EAP=y
CONFIG_EAP_TLS=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_MD5=y
CONFIG_EAP_GTC=y
CONFIG_EAP_SIM=y
CONFIG_EAP_AKA=y
CONFIG_EAP_AKA_PRIME=y
CONFIG_EAP_PAX=y
CONFIG_EAP_PSK=y
CONFIG_EAP_PWD=y
CONFIG_EAP_SAKE=y
CONFIG_EAP_GPSK=y
CONFIG_EAP_GPSK_SHA256=y
CONFIG_EAP_FAST=y
CONFIG_EAP_TEAP=y
CONFIG_EAP_EKE=y
CONFIG_EAP_IKEV2=y
CONFIG_TLS=openssl
# Use the built-in MD4/DES implementations for MS-CHAPv2. This avoids an
# OpenSSL 3 legacy-provider dependency in the native Windows runtime.
CONFIG_INTERNAL_MD4=y
CONFIG_INTERNAL_DES=y
CONFIG_NO_CONFIG_WRITE=y
# Use the UDP control interface on Windows; the default UNIX-domain socket is
# not available in the native Windows build.
CONFIG_CTRL_IFACE=udp-remote
# Keep the full hostapd feature set in the native build. Runtime capability
# advertisement remains controlled by the wifit3 bridge handshake.
CONFIG_RADIUS_SERVER=y
CONFIG_RADIUS_TLS=y
CONFIG_SAE=y
CONFIG_SAE_PK=y
CONFIG_SHA384=y
CONFIG_SHA512=y
CONFIG_IEEE80211R=y
CONFIG_IEEE80211AC=y
CONFIG_IEEE80211AX=y
CONFIG_OCV=y
# macOS: make CONFIG_OS=unix, Windows: make CONFIG_NATIVE_WINDOWS=y
